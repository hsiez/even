{
  "name": "even-workbench",
  "version": "0.1.0",
  "description": "Local authenticated backend adapter for Eve projects",
  "type": "module",
  "bin": {
    "even": "src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "openapi.yaml"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:contract": "node --test test/openapi.test.js",
    "test:ui": "npm --prefix frontend test",
    "storybook": "npm --prefix frontend run storybook",
    "build-storybook": "npm --prefix frontend run build-storybook",
    "test:all": "npm test && npm run test:ui"
  },
  "license": "MIT",
  "dependencies": {
    "polka": "0.5.2",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
