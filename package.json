{
  "name": "even-workbench",
  "version": "0.1.0",
  "description": "Local authenticated backend adapter for Eve projects",
  "type": "module",
  "bin": {
    "even": "src/cli.js"
  },
  "files": [
    "src",
    "frontend/dist",
    "README.md",
    "LICENSE",
    "openapi.yaml"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:design && npm run lint:effects",
    "lint:js": "eslint . --max-warnings 0",
    "lint:design": "stylelint 'frontend/src/**/*.css' 'frontend/.storybook/*.css' --max-warnings 0",
    "lint:effects": "node scripts/audit-code.mjs --check",
    "lint:audit": "node scripts/audit-code.mjs",
    "test:lint": "node --test test/lint.test.js",
    "dev:ui": "npm --prefix frontend run dev",
    "build:ui": "npm --prefix frontend run build",
    "prepack": "npm run build:ui >&2",
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:contract": "node --test test/openapi.test.js",
    "test:ui": "npm --prefix frontend test",
    "test:app": "npm run build:ui && node frontend/scripts/check-app.mjs",
    "storybook": "npm --prefix frontend run storybook",
    "build-storybook": "npm --prefix frontend run build-storybook",
    "test:all": "npm run lint && npm test && npm run test:ui"
  },
  "license": "MIT",
  "dependencies": {
    "polka": "0.5.2",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "color-name": "^2.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-web-api": "^5.30.6",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "postcss-value-parser": "^4.2.0",
    "stylelint": "^18.1.0",
    "yaml": "^2.9.1"
  }
}
