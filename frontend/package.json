{
  "name": "even-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "npm run tokens:check && vitest run",
    "test:watch": "npm run tokens:generate && vitest",
    "storybook": "npm run tokens:generate && storybook dev -p 6006",
    "build-storybook": "npm run tokens:generate && storybook build",
    "test:browser": "node scripts/check-stories.mjs",
    "format:check": "prettier --check src tokens .storybook scripts vite.config.js style-dictionary.config.js",
    "tokens:generate": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "tokens:watch": "node --watch --watch-path=tokens --watch-path=style-dictionary.config.js scripts/build-tokens.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "colorjs.io": "^0.7.1",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "style-dictionary": "^5.8.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  }
}
